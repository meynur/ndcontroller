APP_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./data/node_controller.db
DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com
ALLOWED_ORIGINS=["https://yourdomain.com"]
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=120
SSH_DISABLE_KNOWN_HOSTS=true
MAX_BULK_JOB_CONCURRENCY=5
DEFAULT_TERMINAL_COLS=120
DEFAULT_TERMINAL_ROWS=32
CADDY_BASIC_AUTH_USER=admin
CADDY_BASIC_AUTH_HASH=replace-with-caddy-hash
